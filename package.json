{
  "name": "gym-trainer-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test src/app.test.ts",
    "test:integration": "node --import tsx --test src/fitness.integration.test.ts",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.15",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.15",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
